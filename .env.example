# FORGE Environment Configuration Example
# Copy this file to .env to override default system settings if desired.

# Log level: DEBUG, INFO, WARNING, ERROR
FORGE_LOG_LEVEL=INFO

# Application data directory override (default uses platformdirs)
# FORGE_DATA_DIR=/path/to/forge/data

# Explicit Blender executable path (if not in system PATH)
# Windows example:
# FORGE_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
# Linux example:
# FORGE_BLENDER_PATH=/usr/bin/blender
# macOS example:
# FORGE_BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# UI theme: dark, light, system
FORGE_UI_THEME=dark

# Subprocess default timeout in seconds
FORGE_DEFAULT_TIMEOUT=45
