[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ integration.id }}"
version = "{{ integration.version }}"
description = "{{ integration.name }} - Generated by FORGE Integration Factory"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    "mcp>=2.3.0",
    "pydantic>=2.10.0",
    "jsonschema>=4.20.0",
    "pyyaml>=6.0",
    "forge-integration-platform>=0.1.0",
]

[project.scripts]
{{ integration.id }}-server = "server:main"
